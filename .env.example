# Salin menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Anon key atau publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notifikasi email form kontak via Resend — server only (jangan diawali NEXT_PUBLIC_)
RESEND_API_KEY=
# Alamat tujuan notifikasi
CONTACT_NOTIFY_EMAIL=Andikarmdni22@gmail.com
# Pengirim. Untuk produksi, pakai domain yang sudah diverifikasi di Resend.
# Bila kosong dipakai onboarding@resend.dev (hanya bisa mengirim ke email pemilik akun Resend).
RESEND_FROM_EMAIL=
